[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = ">=0.115.0"
uvicorn = {extras = ["standard"], version = ">=0.30.0"}
sqlalchemy = {extras = ["asyncio"], version = ">=2.0.0"}
alembic = ">=1.13.0"
asyncpg = ">=0.29.0"
python-jose = {extras = ["cryptography"], version = ">=3.3.0"}
httpx = ">=0.27.0"
python-dotenv = ">=1.0.0"
pydantic-settings = ">=2.0.0"
slowapi = ">=0.1.9"
passlib = {extras = ["bcrypt"], version = ">=1.7.4"}
bcrypt = "==4.0.1"
python-multipart = ">=0.0.9"
aiofiles = ">=23.0.0"

# ─── ML / inference stack (P2–P5) ───
# torch must be installed from the CPU index:
#   pip install --index-url https://download.pytorch.org/whl/cpu torch==2.4.1
# torch 2.4.x is the first release line that supports NumPy 2, which is what
# spaCy 3.8 / thinc require. See backend/scripts/setup_venv.ps1.
torch = "==2.4.1"
transformers = "==4.45.2"
peft = "==0.15.2"
sentence-transformers = "==3.3.1"
numpy = "==2.1.3"
spacy = "==3.8.5"

[dev-packages]
pytest = ">=8.0.0"
pytest-asyncio = ">=0.23.0"
pytest-cov = ">=6.0.0"
httpx = ">=0.27.0"

[requires]
python_version = "3.11"
